# FinTrace Studio for Render (web service). The benchmark image stays in ./Dockerfile.
FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

ENV PYTHONHASHSEED=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_CACHE=1 \
    UV_FROZEN=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy

RUN pip install --no-cache-dir uv==0.11.26 && useradd -m -u 1001 agent

WORKDIR /app
COPY . .
RUN uv sync --frozen --no-dev && mkdir -p runs && chown agent:agent runs

# Episodes are generated per request into temporary directories; runs/ holds Studio summaries.
USER agent
EXPOSE 10000
CMD ["uv", "run", "--no-sync", "python", "-m", "fintrace.web_server", "--host", "0.0.0.0"]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fintrace.local/schemas/observation.schema.json",
  "title": "FinTrace observation (DRAFT by Role 2, to be moved to schemas/ by Role 3)",
  "type": "object",
  "required": ["ok", "result", "error", "steps_used", "steps_left"],
  "additionalProperties": false,
  "properties": {
    "ok": {"type": "boolean"},
    "steps_used": {"type": "integer", "minimum": 0},
    "steps_left": {"type": "integer", "minimum": 0},
    "result": {"type": ["object", "null"]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": {"enum": ["UNKNOWN_TOOL", "BAD_ARGS", "UNKNOWN_ID", "BAD_CURSOR", "CALC_ERROR", "EPISODE_DONE"]},
            "message": {"enum": ["unknown tool", "invalid arguments", "record not found", "invalid cursor", "invalid expression", "episode is not active"]}
          }
        }
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}},
     "then": {"properties": {"result": {"type": "object"}, "error": {"type": "null"}}},
     "else": {"properties": {"result": {"type": "null"}, "error": {"type": "object"}}}}
  ]
}
